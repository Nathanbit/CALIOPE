// PARCHE DE ALERTAS + INPUTS para MacroFlow v0.9.4. No es el script completo:
// copia estos bloques en tu .pine real conservando tus capas 1-3.
//@version=6
strategy("MacroFlow REA - Structural Validation", overlay = true, process_orders_on_close = false)

const string MODEL_VERSION = "0.9.4"

// ── Inputs que el optimizador reescribe (los nombres deben coincidir con config/param_space.json)
correlationLookback = input.int(50, "Pearson lookback", minval = 10)
minAbsCorrelation   = input.float(0.1, "|r| mínimo", step = 0.05)
minCorrelationTStat = input.float(2.0, "t-Stat mínimo", step = 0.1)
transNormLen        = input.int(100, "Z-Score window (transmisión)")
transExtremeZ       = input.float(2.0, "Tail Risk sigma", step = 0.1)
fastLen             = input.int(20, "Kaufman ER length")
slowLen             = input.int(50, "HMA/EMA length")
slAtrMult           = input.float(2.0, "SL ATR mult", step = 0.1)
riskPct             = input.float(0.5, "Riesgo por trade %", step = 0.1)
webhookSecret       = input.string("change-me", "Webhook secret")

// ── Corrección Capa 2: la línea original `not ta.change(macroSPY) == 0` se evalúa como
//    `(not ta.change(macroSPY)) == 0` y no compila en v6 (no hay cast implícito float->bool).
// bool transmissionActive = ta.change(macroSPY) != 0
// ── Corrección: ta.log no existe en Pine -> math.log
// float assetReturn = math.log(close / close[1])
// float spyReturn   = math.log(macroSPY / macroSPY[1])

// ── Payload que espera el puente (macroflow/bridge/schemas.py)
f_alert(string action, string grade, float sl, float tp1, float tp2, float tp3) =>
    string slTxt = na(sl) ? "null" : str.tostring(sl)
    string tpTxt = na(tp1) ? "" : str.tostring(tp1) + "," + str.tostring(tp2) + "," + str.tostring(tp3)
    '{"secret":"' + webhookSecret + '","alert_id":"' + syminfo.tickerid + "-" + str.tostring(time) + "-" + action +
     '","model_version":"' + MODEL_VERSION + '","ticker":"' + syminfo.tickerid + '","action":"' + action +
     '","grade":"' + grade + '","price":' + str.tostring(close) + ',"sl":' + slTxt + ',"tp":[' + tpTxt + ']' +
     ',"risk_pct":' + str.tostring(riskPct) + ',"bar_time":' + str.tostring(time_close) + "}"

