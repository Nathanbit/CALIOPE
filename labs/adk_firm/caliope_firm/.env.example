# Copia este archivo como .env (ignorado por git). Solo claves de MODELOS.
# Nunca pongas aquí las claves de BloFin: van en la terminal (desk/README.md).
GOOGLE_API_KEY=""

# Analistas: autor=modelo separados por ";". Lo que no empieza por "gemini" va por LiteLLM.
CALIOPE_ADK_ANALYSTS="ia:gemini=gemini-flash-latest"
# Ejemplo con varias IAs (cada una necesita su clave, p. ej. DEEPSEEK_API_KEY):
# CALIOPE_ADK_ANALYSTS="ia:gemini=gemini-flash-latest;ia:deepseek=deepseek/deepseek-chat"
CALIOPE_ADK_RISK_MODEL="gemini-flash-latest"
