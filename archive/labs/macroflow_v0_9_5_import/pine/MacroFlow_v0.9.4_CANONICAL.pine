//@version=6
//@strategy_alert_message {"action":"{{strategy.order.action}}","order_id":"{{strategy.order.id}}","price":{{strategy.order.price}},"ticker":"{{ticker}}","volume":{{strategy.order.contracts}},"meta":{{strategy.order.alert_message}}}
strategy("MacroFlow v0.9.4 REA - Structural Validation", shorttitle = "MF BT V094", overlay = true, pyramiding = 0, initial_capital = 10000, currency = currency.USD, commission_type = strategy.commission.percent, commission_value = 0.08, slippage = 0, margin_long = 25, margin_short = 25, process_orders_on_close = true, calc_on_order_fills = false, calc_on_every_tick = true, max_labels_count = 200)

const string MODEL_VERSION = "MF-0.9.4-REA-VAL"

// MacroFlow v0.9 REA separates three independent questions:
// 1) Fundamental regime: slow policy, inflation and financial-condition data.
// 2) Market transmission: whether cross-asset markets are pricing risk-on/off.
// 3) Microstructure: whether the traded instrument offers an executable setup.
// Confirmed-bar setups include opening-range behavior and original reaction-zone
// rules based on observable EMA/VWAP/pivot behavior. No proprietary rules are
// claimed. Signals are plans, not fills, and grades are not probabilities.
// O = observed feed data, D = derived transformation, I = model inference.

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
string G_MODE = "1. Model and profile"
string mode = input.string("Scalp", "Operating mode", options = ["Scalp", "Intraday", "Swing", "Custom"], group = G_MODE)
string customGateMode = input.string("Scalp", "Custom gate rules", options = ["Scalp", "Intraday", "Swing"], tooltip = "When Operating mode is Custom, weights remain custom while data freshness and directional gates follow this profile.", group = G_MODE)
string profile = input.string("Crypto / Risk assets", "Transmission profile", options = ["Crypto / Risk assets", "US indices"], group = G_MODE)
string frequencyProfile = input.string("Equilibrado", "Signal frequency", options = ["Selectivo", "Equilibrado", "Activo"], tooltip = "Adjusts score, MTF, cost and cooldown thresholds without changing the underlying setup definitions.", group = G_MODE)
string experimentId = input.string("REA-0065", "Experiment ID", tooltip = "Change this ID whenever model rules or parameters change.", group = G_MODE)
float customFundWeight = input.float(20.0, "Custom fundamental weight", minval = 0, maxval = 100, group = G_MODE)
float customTransWeight = input.float(30.0, "Custom transmission weight", minval = 0, maxval = 100, group = G_MODE)
float customMicroWeight = input.float(50.0, "Custom micro weight", minval = 0, maxval = 100, group = G_MODE)

string G_MACRO = "2. Fundamental regime"
string macroTf = input.timeframe("D", "Macro timeframe", group = G_MACRO)
int macroRocLen = input.int(5, "Change length", minval = 1, group = G_MACRO)
int macroNormLen = input.int(100, "Normalization length", minval = 30, group = G_MACRO)
string us02ySymbol = input.symbol("TVC:US02Y", "US 2Y yield", group = G_MACRO)
string real10ySymbol = input.symbol("FRED:DFII10", "US 10Y real yield", group = G_MACRO)
string breakevenSymbol = input.symbol("FRED:T10YIE", "10Y breakeven inflation", group = G_MACRO)
string oilSymbol = input.symbol("NYMEX:CL1!", "WTI crude oil", group = G_MACRO)
string nfciSymbol = input.symbol("FRED:NFCI", "Financial conditions index", group = G_MACRO)
bool includeOilInInflation = input.bool(true, "Include oil in inflation factor", group = G_MACRO)

string G_TRANS = "3. Market transmission"
string transTf = input.timeframe("15", "Transmission timeframe", group = G_TRANS)
int transRocLen = input.int(4, "Change length", minval = 1, group = G_TRANS)
int transNormLen = input.int(80, "Normalization length", minval = 30, group = G_TRANS)
int maxLiveTransmissionMinutes = input.int(30, "Maximum live-data age (minutes)", minval = 15, maxval = 240, tooltip = "Contextual Scalp/Intraday grades A/B require cross-asset data no older than this limit. Closed-session crypto Technical B uses current crypto evidence instead.", group = G_TRANS)
string spySymbol = input.symbol("AMEX:SPY", "Broad market", group = G_TRANS)
string qqqSymbol = input.symbol("NASDAQ:QQQ", "Growth market", group = G_TRANS)
string vixSymbol = input.symbol("CBOE:VIX", "Volatility", group = G_TRANS)
string dxySymbol = input.symbol("TVC:DXY", "US dollar", group = G_TRANS)
string hygSymbol = input.symbol("AMEX:HYG", "High-yield credit", group = G_TRANS)
string iefSymbol = input.symbol("NASDAQ:IEF", "Treasury comparison", group = G_TRANS)
string rspSymbol = input.symbol("AMEX:RSP", "Equal-weight breadth", group = G_TRANS)
string smhSymbol = input.symbol("NASDAQ:SMH", "Semiconductors", group = G_TRANS)
float transExtremeZ = input.float(2.0, "Transmission extreme threshold (Z)", minval = 1.0, maxval = 4.0, step = 0.25, tooltip = "Classifies confirmed SPY/VIX/DXY moves beyond ±Z standard deviations as explicit risk extremes.", group = G_TRANS)
bool requireCorrelationEvidence = input.bool(true, "Require significant transmission correlation", tooltip = "Contextual Grades A/B require a confirmed short-term Pearson relationship. Closed-session crypto Technical B treats stale Pearson as observation and relies on current crypto evidence instead.", group = G_TRANS)
string correlationReference = input.string("SPY", "Correlation reference", options = ["SPY", "VIX"], group = G_TRANS)
string correlationTf = input.timeframe("15", "Correlation timeframe", tooltip = "Must be equal to or higher than the chart timeframe. Confirmed source-bar returns are used.", group = G_TRANS)
int correlationLookback = input.int(20, "Correlation observations", minval = 10, maxval = 100, group = G_TRANS)
float minAbsCorrelation = input.float(0.25, "Minimum |Pearson r|", minval = 0.05, maxval = 0.95, step = 0.05, group = G_TRANS)
float minCorrelationTStat = input.float(2.0, "Minimum correlation |t|", minval = 1.0, maxval = 5.0, step = 0.25, tooltip = "Approximate two-sided significance control using t = r·sqrt((n−2)/(1−r²)).", group = G_TRANS)

string G_MICRO = "4. Microstructure"
string trendEstimator = input.string("EMA", "Trend estimator", options = ["HMA blend", "HMA", "EMA"], tooltip = "EMA is the validated baseline. HMA blend is experimental and its HMA weight adapts to trend efficiency and variance. Pure HMA remains available only for controlled comparison.", group = G_MICRO)
int fastLen = input.int(20, "Fast EMA", minval = 2, group = G_MICRO)
int slowLen = input.int(65, "Setup EMA", minval = 5, group = G_MICRO)
