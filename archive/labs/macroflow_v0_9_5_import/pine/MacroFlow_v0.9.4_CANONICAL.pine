bool useExtensionFade = input.bool(true, "Use far-from-MA reversal", tooltip = "Enables the experimental volatility-normalized reversal. TREND_PULLBACK remains part of the core reaction model. No proprietary WSGTA rules are claimed.", group = G_MICRO)
int rsiLen = input.int(14, "Reversal RSI length", minval = 2, group = G_MICRO)
float rsiOversold = input.float(30.0, "Reversal RSI oversold", minval = 5, maxval = 45, step = 1, group = G_MICRO)
float rsiOverbought = input.float(70.0, "Reversal RSI overbought", minval = 55, maxval = 95, step = 1, group = G_MICRO)
float farMaAtr = input.float(1.50, "Far-from-MA distance in ATR", minval = 0.50, maxval = 5.0, step = 0.10, tooltip = "Normalizes overextension across BTC, indices and other instruments instead of using a fixed dollar distance.", group = G_MICRO)
int pivotLen = input.int(3, "Confirmed pivot sides", minval = 1, maxval = 10, group = G_MICRO)
int volLen = input.int(20, "Relative-volume length", minval = 5, group = G_MICRO)
float minRelVolume = input.float(1.20, "Preferred relative volume", minval = 0.5, step = 0.05, group = G_MICRO)
float minBodyEfficiency = input.float(0.55, "Breakout body/range", minval = 0.1, maxval = 1, step = 0.05, group = G_MICRO)
bool requireVolumeEvidence = input.bool(true, "Require observed volume for A/B", tooltip = "Disable only for feeds that genuinely do not provide useful volume. Missing volume is never treated as normal volume.", group = G_MICRO)
float reactionToleranceAtr = input.float(0.15, "Reaction-zone tolerance in ATR", minval = 0.02, maxval = 0.75, step = 0.01, tooltip = "Distance allowed around EMA20, setup EMA, operative VWAP or the latest confirmed pivot.", group = G_MICRO)
bool useVoidBonus = input.bool(true, "Use fresh 3-candle void bonus", tooltip = "Uses a causal three-candle imbalance and consumes it on its first mitigation. It adds score or a reaction zone; it never gates a setup.", group = G_MICRO)
float minVoidAtr = input.float(0.10, "Minimum void height in ATR", minval = 0.02, maxval = 1.0, step = 0.01, group = G_MICRO)
string mtf1 = input.timeframe("15", "Fast confirmation TF 1", group = G_MICRO)
string mtf2 = input.timeframe("60", "Fast confirmation TF 2", group = G_MICRO)
string mtf3 = input.timeframe("240", "Slow confirmation TF", group = G_MICRO)
float extensionStdevMult = input.float(2.00, "Extension standard deviations", minval = 1.00, maxval = 4.00, step = 0.25, tooltip = "EXT_FADE requires price to exceed both this EMA200 deviation band and the existing ATR distance.", group = G_MICRO)
int divergenceMaxBars = input.int(80, "Maximum bars between RSI pivots", minval = 5, maxval = 300, tooltip = "Limits confirmed regular RSI divergence to structurally related pivots.", group = G_MICRO)

