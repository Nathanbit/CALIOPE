float feePerSidePct = input.float(0.08, "Fee per side (%)", minval = 0, step = 0.01, group = G_RISK)
float slippagePerSidePct = input.float(0.02, "Slippage per side (%)", minval = 0, step = 0.01, group = G_RISK)
float minNetRRA = input.float(1.30, "Net R:R floor for A", minval = 0.5, step = 0.1, tooltip = "Acts as the user's hard floor. Equilibrado and Selectivo can raise it.", group = G_RISK)
float minNetRRB = input.float(0.90, "Net R:R floor for B", minval = 0.5, step = 0.1, tooltip = "Acts as the user's hard floor. Equilibrado and Selectivo can raise it.", group = G_RISK)
float maxCostLoad = input.float(0.50, "Maximum costs / gross target", minval = 0.05, maxval = 1, step = 0.05, tooltip = "Acts as the user's hard ceiling. Equilibrado and Selectivo can tighten it.", group = G_RISK)
int cooldownBars = input.int(4, "Base cooldown after plan", minval = 0, maxval = 100, tooltip = "The frequency profile adjusts this value.", group = G_RISK)
int maxPlanBars = input.int(36, "Maximum active-plan bars", minval = 2, maxval = 500, tooltip = "A displayed plan expires after this many chart bars if neither stop nor final target was touched.", group = G_RISK)
