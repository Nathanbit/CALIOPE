float retestToleranceAtr = input.float(0.10, "Retest tolerance in ATR", minval = 0.01, step = 0.01, group = G_OPEN)
float retestMaxPenetrationAtr = input.float(0.50, "Maximum retest penetration in ATR", minval = 0.10, maxval = 2.0, step = 0.05, tooltip = "Allows a deeper sweep through the level, but still requires a confirmed reclaim close outside the box.", group = G_OPEN)
float maxChaseAtr = input.float(0.35, "Maximum chase distance in ATR", minval = 0.05, step = 0.05, group = G_OPEN)
