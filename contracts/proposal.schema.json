{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caliope.local/schemas/proposal.schema.json",
  "title": "CALIOPE bounded change proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "iteration", "agent_id", "parent_candidate_hash",
    "hypothesis", "target_files", "invariants", "validation_plan", "rollback",
    "evidence_refs", "patch"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 8, "maxLength": 80},
    "iteration": {"type": "integer", "minimum": 0, "maximum": 2},
    "agent_id": {"const": "deterministic_builder"},
    "parent_candidate_hash": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "hypothesis": {"type": "string", "minLength": 10, "maxLength": 1500},
    "expected_effect": {"type": "string", "maxLength": 1000},
    "target_files": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(source|tests|docs)/[A-Za-z0-9_./-]+$"}
    },
    "invariants": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {"type": "string", "maxLength": 300}
    },
    "validation_plan": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {"type": "string", "maxLength": 500}
    },
    "rollback": {"type": "string", "minLength": 3, "maxLength": 500},
    "evidence_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 300}
    },
    "patch": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "sha256", "content"],
      "properties": {
        "format": {"const": "unified_diff"},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "content": {"type": "string", "maxLength": 100000}
      }
    }
  }
}
